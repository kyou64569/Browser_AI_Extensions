{
  "manifest_version": 3,
  "name": "AI 助手（个人）",
  "version": "0.1.0",
  "description": "个人用 AI 助手扩展：模型适配层 + 备用降级 + 网页总结。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting", "tabs", "tabCapture", "contextMenus", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI 助手"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+A" },
      "description": "打开/聚焦 AI 助手侧边栏"
    }
  },
  "side_panel": {
    "default_path": "preview/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "ui/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/translate.js", "content/extract.js", "content/sidebar-inject.js", "content/subtitle.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "preview/index.html",
        "preview/preview.css",
        "preview/preview.js",
        "shared/dom-tools.js",
        "shared/extract.js",
        "offscreen/pcm-worklet.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
